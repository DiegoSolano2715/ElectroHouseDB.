alter table productos 
add cantidad varchar(15);

UPDATE productos
SET cantidad = '30';

select * from productos;

BEGIN TRANSACTION;

DECLARE @ID_cliente INT = 1;
DECLARE @ID_producto INT = 3;
DECLARE @cantidad INT = 5;

IF (SELECT CAST(@cantidad AS INT) FROM productos WHERE ID_producto = @ID_producto) >= @cantidad
BEGIN
    INSERT INTO ordenes (ID_cliente, fecha_orden)
    VALUES (@ID_cliente, GETDATE());

    DECLARE @ID_orden INT = SCOPE_IDENTITY();

    INSERT INTO detalle_orden (ID_orden, ID_producto, cantidad)
    VALUES (@ID_orden, @ID_producto, @cantidad);

    UPDATE productos
    SET @cantidad = CAST(@cantidad AS INT) - @cantidad
    WHERE ID_producto = @ID_producto;

    COMMIT;
    PRINT 'Venta realizada con éxito.';
END
ELSE
BEGIN
    ROLLBACK;
    PRINT 'Stock insuficiente. Venta cancelada.';
END;
